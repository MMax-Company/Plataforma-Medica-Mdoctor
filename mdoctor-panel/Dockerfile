FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
ARG API_PROXY_TARGET=https://mdoctor-backend-staging-staging.up.railway.app
ARG NEXT_PUBLIC_API_URL=https://mdoctor-backend-staging-staging.up.railway.app
ARG NEXT_PUBLIC_APP_ENV=staging
ARG NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=false
ENV API_PROXY_TARGET=$API_PROXY_TARGET
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=$NEXT_PUBLIC_ENABLE_MOCK_FALLBACK
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["npm", "start"]
