NODE_ENV=development
ENVIRONMENT_NAME=local
DATA_ENV=local
PORT=3004
BASE_URL=http://localhost:3004
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug
DISABLE_LOCAL_DB_FALLBACK=true
SUPABASE_REQUIRED=true
# Apenas desenvolvimento sem banco real (NUNCA em staging/prod):
# SUPABASE_PERSISTENCE_OPTIONAL=true

JWT_SECRET=
MEDICO_USER=admin
MEDICO_PASS=change-me-local
MEDICO_ROLE=admin
MEDICO_NOME=Medico Local

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string (Settings → Database → Session pooler, região us-west-2 para usihurogvphtjedyhyfl)
# Formato: postgresql://postgres.<project_ref>:<senha>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
# Se a senha contiver @, codifique como %40 na URI.
SUPABASE_DB_URL=
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_PRESCRIPTIONS=prescriptions
SUPABASE_BUCKET_MEDICAL_RECORDS=medical-records
SUPABASE_BUCKET_CONSENTS=consents
SUPABASE_BUCKET_LOGS=logs
SUPABASE_BUCKET_RECEITAS_ANTERIORES=receitas-anteriores
PREVIOUS_PRESCRIPTION_MAX_BYTES=10485760
PREVIOUS_PRESCRIPTION_SIGNED_TTL_SECONDS=3600
PRESCRIPTION_EXTERNAL_UPLOAD=true
PRESCRIPTION_UPLOAD_TOKEN_TTL_MS=86400000
UPLOAD_PAGE_BASE_URL=https://painel-medico-staging-staging.up.railway.app
PUBLIC_BASE_URL=https://mdoctor-backend-staging-staging.up.railway.app
UPLOAD_RATE_LIMIT_MAX=30

MEMED_ENABLED=false
MEMED_REAL_ENABLED=false
MEMED_ENVIRONMENT=development
MEMED_ENV=development
MEMED_API_URL=https://integrations.api.memed.com.br/v1
MEMED_TIMEOUT_MS=8000
MEMED_RETRY_ATTEMPTS=2
MEMED_ALLOW_MOCK_FALLBACK=true
MEMED_MIRROR_PDF_TO_STORAGE=false
MEMED_CALLBACK_URL=
MEMED_API_KEY=
MEMED_SECRET_KEY=
MEMED_INTEGRATION_KEY=
MEMED_TOKEN=
MEMED_CRM=
MEMED_UF=
MEMED_PRESCRITOR_EXTERNAL_ID=
MEMED_PRESCRITOR_NOME=
MEMED_PRESCRITOR_SOBRENOME=
MEMED_PRESCRITOR_CPF=
MEMED_PRESCRITOR_BOARD_NUMBER=
MEMED_PRESCRITOR_BOARD_STATE=
MEMED_CIDADE_ID=
MEMED_ESPECIALIDADE_ID=
DELIVERY_REAL_ENABLED=false

WHATSAPP_ENABLED=false
# mock | evolution | meta — Evolution segue sendo o provider real de produção
WHATSAPP_PROVIDER=mock
WHATSAPP_SANDBOX_MODE=true
WHATSAPP_DRY_RUN=true
WHATSAPP_SANDBOX_RATE_LIMIT_MAX=10
WHATSAPP_SANDBOX_RATE_LIMIT_WINDOW_MS=60000
WHATSAPP_SANDBOX_MIN_INTERVAL_MS=15000
N8N_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
INGRESS_SERVICE_SECRET=
N8N_CLINICAL_REJECT_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_MS=12000
WEBHOOK_RATE_LIMIT_MAX=20
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_BUCKETS=10000
WEBHOOK_IDEMPOTENCY_TTL_MS=86400000
WEBHOOK_IDEMPOTENCY_MAX_ENTRIES=5000
# Evolution API (oficial: https://github.com/evolution-foundation/evolution-api)
# Docker recomendado: evoapicloud/evolution-api:latest (porta 8080)
# AUTHENTICATION_API_KEY do servidor Evolution -> EVOLUTION_API_KEY no backend
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_TIMEOUT_MS=12000

# Meta WhatsApp Cloud API (webhook em src/routes/whatsapp.routes.js; envio em
# src/services/providers/meta.provider.js — ainda não é o provider ativo de
# produção; defina WHATSAPP_PROVIDER=meta explicitamente para usá-lo)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_GRAPH_TIMEOUT_MS=12000
# WABA ID — gestão de templates (whatsapp_business_management), rotas
# GET/POST/DELETE /api/admin/whatsapp/templates
WHATSAPP_BUSINESS_ACCOUNT_ID=
DELIVERY_MOCK_ENABLED=true
ALLOW_PRODUCTION_DELIVERY_MOCK=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TYPEBOT_WEBHOOK_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:3004
