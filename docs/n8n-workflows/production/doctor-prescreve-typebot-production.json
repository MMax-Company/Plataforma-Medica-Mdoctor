    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet telefone = input.phone || input.from || \"\";\ntelefone = String(telefone).replace(/[^0-9]/g, \"\");\nif (telefone.startsWith(\"55\") && telefone.length > 10) {\n  telefone = telefone.substring(2);\n}\n\nconst nome = input.name || input.pushname || \"Paciente\";\nconst mensagem = (input.text || input.body || input.mensagem || \"\").toLowerCase().trim();\n\nreturn [{\n  json: {\n    telefone: telefone,\n    nome: nome,\n    mensagem: mensagem\n  }\n}];"
      },
