      "parameters": {
        "jsCode": "return [{\n  json: {\n    telefone: $json.telefone,\n    resposta: `👨‍⚕️ *DOCTOR PRESCREVE* 🏥\\n\\nOlá *${$json.nome}*!\\n\\nClique para iniciar sua consulta:\\n\\n🔗 https://typebot.co/doctor-prescreve-8rmljgu`\n  }\n}];"
      },
      "id": "2f5b90c4-964b-41d6-80a6-398ceaea40dd",
