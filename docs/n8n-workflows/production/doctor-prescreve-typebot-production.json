    {
      "parameters": {
        "jsCode": "const msg = $json.mensagem;\nlet resposta = \"\";\nif (msg === \"1\" || msg === \"sim\") {\n  resposta = `✅ *Inicie sua consulta*\\n🔗 https://typebot.co/doctor-prescreve-8rmljgu`;\n} else if (msg === \"2\" || msg === \"ajuda\") {\n  resposta = `📞 *Suporte*\\nResponderemos em até 2h`;\n} else {\n  resposta = `❓ Digite:\\n1 - Iniciar\\n2 - Suporte`;\n}\nreturn [{ json: { telefone: $json.telefone, resposta } }];"
      },
      "id": "d3acf427-0ac1-4c84-a716-3feb323e2f97",
