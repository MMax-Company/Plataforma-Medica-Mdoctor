    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst dados = raw.body || raw.data || raw;\n\nlet telefone = String(dados.whatsapp || dados.telefone || \"\").replace(/[^0-9]/g, \"\");\nif (!telefone.startsWith(\"55\")) telefone = \"55\" + telefone;\n\nlet dataNascimento = dados.data_nascimento || \"\";\nif (dataNascimento && dataNascimento.includes(\"/\")) {\n  const p = dataNascimento.split(\"/\");\n  dataNascimento = `${p[2]}-${p[1]}-${p[0]}`;\n}\n\nconst doencas = dados.doenca_cronica ? [dados.doenca_cronica] : [];\nconst isElegivel = (dados.sinais_alerta || \"NAO\") === \"NAO\" && doencas.length > 0;\n\nreturn [{\n  json: {\n    elegivel: isElegivel,\n    nome: dados.Nome_Completo || \"\",\n    cpf: dados.cpf_paciente || \"\",\n    telefone: telefone,\n    email: dados.Email || \"\",\n    data_nascimento: dataNascimento,\n    medicamento: dados.primeiro_medicamento || \"\",\n    doenca: dados.doenca_cronica || \"\"\n  }\n}];"
      },
