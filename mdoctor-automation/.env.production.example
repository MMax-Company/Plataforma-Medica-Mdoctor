NODE_ENV=production
PORT=5678

# Backend oficial do Mdoctor backend em producao
BACKEND_URL=https://SEU-BACKEND.up.railway.app
BACKEND_TIMEOUT_MS=10000
HEALTH_TIMEOUT_MS=4000

# Obrigatorio em producao. Use o mesmo valor nos chamadores dos webhooks.
AUTOMATION_WEBHOOK_SECRET=troque-por-um-segredo-forte

# Opcional: encaminhar eventos de decisao para ferramenta externa.
# Se vazio, /webhook/decisao apenas aceita e audita a chamada via metricas.
DECISION_WEBHOOK_FORWARD_URL=

# Worker Redis opcional
REDIS_URL=redis://default:SENHA@HOST:PORT
WHATSAPP_QUEUE_NAME=whatsapp_queue
AUTOMATION_WORKER_INTERVAL_MS=1000
AUTOMATION_WORKER_MAX_ATTEMPTS=3
