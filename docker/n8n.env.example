# Cópia local — NÃO commitar docker/n8n.env (contém segredos).
# Gerar N8N_API_KEY em n8n UI: Settings → n8n API

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

N8N_PUBLIC_API_DISABLED=false
N8N_PUBLIC_API_ENDPOINT=api

N8N_API_KEY=
N8N_BASE_URL=https://n8n-node-production-f844.up.railway.app

BACKEND_BASE_URL=https://mdoctor-backend-staging-staging.up.railway.app
