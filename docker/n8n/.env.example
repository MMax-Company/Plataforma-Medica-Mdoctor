# Copie para .env e troque todos os valores marcados como CHANGE_ME
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# --- Public API ---
N8N_PUBLIC_API_DISABLED=false
N8N_PUBLIC_API_SWAGGERUI_DISABLED=false

# Não é variável oficial do n8n; mantida por compatibilidade com checklists.
# Com N8N_PUBLIC_API_DISABLED=false, gere a chave em Settings → n8n API.
N8N_API_KEY_ENABLED=true

# --- Basic Auth (camada extra na porta 5678) ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_senha_forte

# --- Host / webhooks (local) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# Obrigatório: mesma chave sempre que reutilizar o volume (32+ caracteres aleatórios)
N8N_ENCRYPTION_KEY=CHANGE_ME_gerar_string_aleatoria_longa

# Opcional: após criar em Settings → n8n API (deploy local lê daqui se definido)
# N8N_API_KEY=n8n_api_xxxxxxxx

# --- Fuso ---
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# --- Servidor (exemplo; descomente e ajuste em produção) ---
# N8N_HOST=n8n.seudominio.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.seudominio.com/
# N8N_EDITOR_BASE_URL=https://n8n.seudominio.com/
